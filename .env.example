# Database Connection (PostgreSQL) - Matches Docker Compose defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamsynch-ai
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamsynch-ai

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379

# JWT Security Secrets (Minimum 32 Characters Each)
JWT_ACCESS_SECRET=teamsynch_access_secret_key_32_characters_min
JWT_REFRESH_SECRET=teamsynch_refresh_secret_key_32_characters_min
JWT_ISSUER=teamsynch-ai-api
JWT_ACCESS_AUDIENCE=teamsynch-ai-api
JWT_REFRESH_AUDIENCE=teamsynch-ai-auth
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend Origin URL
FRONTEND_URL=http://localhost:5173

# AI Layer Configuration (MOCK or OPENAI)
AI_PROVIDER=MOCK
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Object Storage Configuration (local or s3)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=teamsynch-uploads
AWS_REGION=us-east-1

# Token Encryption Secret (for Calendar OAuth Tokens at Rest)
ENCRYPTION_SECRET_KEY=teamsynch_encryption_secret_key_32_chars_min

# Stripe Webhooks & Billing (Optional for local dev)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
