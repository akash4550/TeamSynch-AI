# Database Connection (PostgreSQL) - Matches Docker Compose defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamsynch-ai
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamsynch-ai

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379

# JWT Security Secrets (Minimum 32 Characters Each)
JWT_ACCESS_SECRET=teamsynch_access_secret_key_32_characters_min
JWT_REFRESH_SECRET=teamsynch_refresh_secret_key_32_characters_min
# AES-256-GCM key source for calendar OAuth tokens stored at rest
# (min 32 chars). BUG FIX (#106): REQUIRED in production — unset there,
# the API refuses to boot. In dev/test it may stay unset and a loudly
# named development-only fallback is used (never trust it with real data).
ENCRYPTION_SECRET_KEY=teamsynch_encryption_secret_key_32_chars_min
# Seed wipe confirmation (BUG FIX #107): only ever needed to reseed a
# NON-loopback database (e.g. staging). Must equal the exact database
# name from DATABASE_URL, or the seed script refuses to wipe. Never set
# it casually — it is the type-to-confirm for deleting EVERY row.
# SEED_CONFIRM_DATABASE=some_staging_db_name
JWT_ISSUER=teamsynch-ai-api
JWT_ACCESS_AUDIENCE=teamsynch-ai-api
JWT_REFRESH_AUDIENCE=teamsynch-ai-auth
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend Origin URL
FRONTEND_URL=http://localhost:5173

# AI Layer Configuration (MOCK or OPENAI)
AI_PROVIDER=MOCK
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-your-openai-key-here
# FEATURE (ledger #9 — RAG ingestion): embeddings are REAL provider calls.
# With AI_PROVIDER=MOCK the embedding endpoint fails CLOSED (503) so no
# fabricated vectors ever reach the store. AI_EMBEDDING_MODEL/
# AI_EMBEDDING_DIMS must match the migrated pgvector column (vector(1536)).
# OPENAI_BASE_URL enables OpenAI-compatible servers (Ollama/vLLM/LiteLLM).
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMS=1536
#OPENAI_BASE_URL=http://localhost:11434/v1
# Per-org monthly ingestion token budget (5M ≈ $0.10 at 3-small pricing)
# and per-document text cap; the worker stops honestly at both.
AI_RAG_MONTHLY_TOKEN_BUDGET=5000000
AI_RAG_MAX_CHARS_PER_DOC=250000

# Object Storage Configuration (local or s3)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=teamsynch-uploads
AWS_REGION=us-east-1
# Required when STORAGE_PROVIDER=s3. Uploads/deletes are REAL SDK calls
# (ledger #7, @aws-sdk/client-s3) and SigV4 download presigning is real
# (bug fix #60). Missing config fails closed with 503 at operation time;
# upstream S3 errors surface as honest 502s — success is never fabricated.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional (ledger #7): S3-compatible stores (MinIO, Cloudflare R2, …).
# Setting an endpoint auto-enables path-style addressing; override with
# AWS_S3_FORCE_PATH_STYLE=true|false. AWS_S3_CUSTOM_DOMAIN shapes the
# object URL returned on upload when using a CDN/front domain.
#AWS_S3_ENDPOINT=http://localhost:9000
#AWS_S3_FORCE_PATH_STYLE=true
#AWS_S3_CUSTOM_DOMAIN=https://cdn.example.com
# HMAC key for signed LOCAL download URLs (bug fix #60); falls back to
# JWT_REFRESH_SECRET when unset. Optional, min 32 chars.
STORAGE_SIGNING_SECRET=teamsynch_storage_signing_secret_32chars_min
# Optional (ledger #1): dedicated HMAC key for emailed team-invitation accept links.
# Falls back to STORAGE_SIGNING_SECRET, then JWT_REFRESH_SECRET, when unset.
INVITATION_SIGNING_SECRET=teamsynch_invitation_signing_secret_32chars_min

# Stripe Webhooks & Billing (Optional for local dev)
# BUG FIX (#91): fail-closed — without a real key, checkout/portal session
# endpoints answer 503 honestly instead of redirecting users to fabricated
# Stripe URLs. Set a real key before using Subscription Settings' Upgrade /
# Manage-billing buttons.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# FEATURE (ledger #11 — real subscription plumbing): the price↔plan mapping.
# Create three recurring prices in your Stripe account (Starter/Pro/Business)
# and put their REAL ids here — checkout resolves the plan from them and the
# webhook NEVER defaults a purchase to PRO. Missing/unknown mapping fails
# closed (503 at checkout, 400 on an unmapped priceId). Ids differ per
# account and per test/live mode; the web renders its Upgrade buttons from
# GET /billing/subscription's `plans` array.
STRIPE_PRICE_STARTER=price_your_starter_price_id
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_BUSINESS=price_your_business_price_id

# Retention tuning for the nightly daily-cleanup job (ledger #2).
# Positive-int days per residue class; invalid values fall back to 90.
RETENTION_REFRESH_TOKEN_DAYS=90
RETENTION_INVITATION_DAYS=90
RETENTION_NOTIFICATION_DAYS=90

# Calendar OAuth (ledger #3) — real Google/Microsoft authorization-code flow.
# A provider left unset makes its /calendar/connect answer an honest 503.
# API_PUBLIC_URL must be the externally reachable API origin used to build
# the OAuth redirect URIs (register these EXACT URIs in the provider consoles):
#   {API_PUBLIC_URL}/api/v1/calendar/callback/google
#   {API_PUBLIC_URL}/api/v1/calendar/callback/outlook
API_PUBLIC_URL=http://localhost:4000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional: dedicated HMAC key for OAuth state (fallback chain: invitation -> storage -> JWT refresh).
CALENDAR_OAUTH_STATE_SECRET=

# FEATURE (ledger #17 — 2026-08-06): Swagger UI at /api/v1/docs.
# 'true' mounts the docs UI in every environment; 'false' never mounts it.
# Leave unset for the secure default: mounted in development/test,
# WITHHELD in production (route-map disclosure served to nobody).
#ENABLE_API_DOCS=true
