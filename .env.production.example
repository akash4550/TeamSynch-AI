# TeamSynch AI production Docker Compose environment
# Copy this file to .env.production and replace every placeholder.
#
# Database and Redis passwords are interpolated into connection URLs.
# Prefer URL-safe characters: letters, numbers, hyphen, underscore, period, and tilde.

# PostgreSQL
DB_USER=teamsynch-ai
DB_PASSWORD=replace-with-a-strong-url-safe-database-password
DB_NAME=teamsynch-ai_prod

# Redis
REDIS_PASSWORD=replace-with-a-strong-url-safe-redis-password

# Authentication
# Both secrets must be at least 32 characters and must be different.
JWT_ACCESS_SECRET=replace-with-a-distinct-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-distinct-refresh-secret-at-least-32-characters
# REQUIRED (BUG FIX #106): seals stored calendar OAuth tokens with
# AES-256-GCM. Must be at least 32 characters, cryptographically random,
# and DIFFERENT from the JWT secrets. Without it the API refuses to boot
# (previously it silently fell back to a key published in the source).
ENCRYPTION_SECRET_KEY=replace-with-a-distinct-encryption-secret-at-least-32
JWT_ISSUER=teamsynch-ai-api
JWT_ACCESS_AUDIENCE=teamsynch-ai-api
JWT_REFRESH_AUDIENCE=teamsynch-ai-auth

# Public web origin
# Use HTTPS for non-loopback production deployments.
FRONTEND_URL=https://app.example.com

# Published host ports
API_PORT=4000
WEB_PORT=80

# Object storage signed URLs (bug fix #60)
# HMAC key for signed LOCAL download URLs; falls back to JWT_REFRESH_SECRET.
STORAGE_SIGNING_SECRET=replace-with-a-distinct-storage-secret-at-least-32-chars
# Optional (ledger #1): dedicated HMAC key for emailed team-invitation accept links.
# Falls back to STORAGE_SIGNING_SECRET, then JWT_REFRESH_SECRET. Use a distinct value.
INVITATION_SIGNING_SECRET=replace-with-a-distinct-invitation-secret-at-least-32-chars
# Required only when STORAGE_PROVIDER=s3 — real SDK uploads/deletes
# (ledger #7, @aws-sdk/client-s3) and SigV4 presigning credentials (bug fix
# #60). Missing config fails closed with 503; S3 errors surface as 502.
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=your-bucket
# AWS_REGION=your-region
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional (ledger #7): S3-compatible endpoint (MinIO/R2) — auto-enables
# path-style addressing; AWS_S3_FORCE_PATH_STYLE=true|false overrides:
# AWS_S3_ENDPOINT=https://your-minio-or-r2-endpoint
# AWS_S3_FORCE_PATH_STYLE=true

# Retention tuning for the nightly daily-cleanup job (ledger #2).
# Positive-int days per residue class; invalid values fall back to 90.
RETENTION_REFRESH_TOKEN_DAYS=90
RETENTION_INVITATION_DAYS=90
RETENTION_NOTIFICATION_DAYS=90

# Calendar OAuth (ledger #3) — real Google/Microsoft authorization-code flow.
# A provider left unset makes its /calendar/connect answer an honest 503.
# API_PUBLIC_URL must be the externally reachable API origin used to build
# the OAuth redirect URIs (register these EXACT URIs in the provider consoles):
#   {API_PUBLIC_URL}/api/v1/calendar/callback/google
#   {API_PUBLIC_URL}/api/v1/calendar/callback/outlook
API_PUBLIC_URL=https://api.example.com
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional: dedicated HMAC key for OAuth state (fallback chain: invitation -> storage -> JWT refresh).
CALENDAR_OAUTH_STATE_SECRET=
# Stripe Billing (BUG FIX #91 — fail-closed): REQUIRED for checkout / portal.
# Without a real key the endpoints answer 503 honestly rather than redirecting
# users to fabricated Stripe URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# FEATURE (ledger #11): REQUIRED for paid plans — real recurring price ids
# for the Starter/Pro/Business tiers created in THIS Stripe account (live
# mode). Webhook plan resolution fails loudly (no PRO default) if an event
# arrives for an unmapped price.
STRIPE_PRICE_STARTER=price_replace_with_live_starter_id
STRIPE_PRICE_PRO=price_replace_with_live_pro_id
STRIPE_PRICE_BUSINESS=price_replace_with_live_business_id

# AI Layer (FEATURE ledger #9): production requires AI_PROVIDER=OPENAI with
# a real OPENAI_API_KEY; the embedding model/dims below drive the RAG
# ingestion pipeline and MUST match the pgvector column (vector(1536)).
# OPENAI_BASE_URL points at OpenAI-compatible gateways when used.
AI_PROVIDER=OPENAI
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-real-openai-key
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMS=1536
#OPENAI_BASE_URL=
# RAG ingestion budget (per org per month) + per-document text cap.
AI_RAG_MONTHLY_TOKEN_BUDGET=5000000
AI_RAG_MAX_CHARS_PER_DOC=250000

# FEATURE (ledger #17 — 2026-08-06): Swagger UI at /api/v1/docs is
# WITHHELD by default in production (an unauthenticated route map of the
# API surface is attack-surface nobody opted into). Set ENABLE_API_DOCS=true
# ONLY if this deployment intentionally serves public API documentation;
# 'false' (or unset) keeps the route a clean 404.
#ENABLE_API_DOCS=true
