generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url        = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TeamRole {
  OWNER
  LEAD
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// -----------------------------------------------------------------------------
// CORE MODELS
// -----------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?

  isActive  Boolean  @default(true)
  deletedAt DateTime?
subscriptionStatus String?
plan String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  teams           Team[]
  projects        Project[]
  clients         Client[]
  contacts        Contact[]
  leads           Lead[]
  pipelineStages  PipelineStage[]
  opportunities   Opportunity[]
  crmActivities   CRMActivity[]
  documents       Document[]
  embeddings      DocumentEmbedding[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  tasks           Task[]
  events          CalendarEvent[]
  teamInvitations TeamInvitation[]
  AIUsageLog      AIUsageLog[]
  calendarAccounts CalendarAccount[]

  @@index([deletedAt])
  @@index([isActive])
}
model User {
  id             String    @id @default(uuid())
  organizationId String

  firstName      String
  lastName       String
  email          String
  password       String

  role           Role      @default(EMPLOYEE)

  avatar         String?

  isActive       Boolean   @default(true)
  emailVerified  Boolean   @default(false)

  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?

  lastLogin      DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  refreshTokens     RefreshToken[]

  calendarAccounts  CalendarAccount[]

  ownedProjects     Project[]

  assignedTasks     Task[]           @relation("TaskAssignee")
  reportedTasks     Task[]           @relation("TaskReporter")

  teamMemberships   TeamMembership[]
  teamInvitations   TeamInvitation[] @relation("InvitedByUser")
  ownedTeams        Team[]

  notifications     Notification[]
  activityLogs      ActivityLog[]

  uploadedDocuments Document[]

  clients           Client[]
  assignedLeads     Lead[]
  crmActivities     CRMActivity[]
  AIUsageLog        AIUsageLog[]

  @@unique([organizationId, email])

  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
  @@index([organizationId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
tokenHash String @unique
device String?
ipAddress String?
userAgent String?
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
}

// -----------------------------------------------------------------------------
// PLACEHOLDER MODELS (Multi-Tenant Modules)
// -----------------------------------------------------------------------------

model Team {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?   @db.Text
  color          String?
  icon           String?
  ownerId        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User             @relation(fields: [ownerId], references: [id])
  memberships  TeamMembership[]
  invitations  TeamInvitation[]

@@index([organizationId, deletedAt])
  @@unique([organizationId, name])
@@index([organizationId])
@@index([ownerId])
}

model TeamMembership {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvitation {
  id             String           @id @default(uuid())
  organizationId String
  teamId         String
  email          String
  invitedById    String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([teamId])
  @@index([email])
  @@unique([teamId, email])
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  key            String
  description    String?       @db.Text
  status         ProjectStatus @default(PLANNING)
  color          String?
  icon           String?
  ownerId        String
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id])
  tasks        Task[]
  documents    Document[]

  @@unique([organizationId, name])
@@index([organizationId, createdAt])
@@index([organizationId, deletedAt])
  @@unique([organizationId, key])
  @@index([organizationId, status])
@@index([organizationId, ownerId])
@@index([key])
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  parentTaskId   String?
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?
  reporterId     String
  dueDate        DateTime?
  estimatedHours Float?
  completedAt    DateTime?
  position Decimal @db.Decimal(18,6)
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
completedById String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]       @relation("Subtasks")
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter     User         @relation("TaskReporter", fields: [reporterId], references: [id])
  documents    Document[]

@@index([organizationId, projectId])
@@index([organizationId, projectId, status])
@@index([organizationId, assigneeId])
@@index([organizationId, priority])
@@index([organizationId, dueDate])
@@index([organizationId, archived])
@@index([organizationId, createdAt])
@@index([organizationId, deletedAt])
@@index([reporterId])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum CRMActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  STATUS_CHANGE
}

enum AIProvider {
  OPENAI
  GEMINI
  ANTHROPIC
  MOCK
}


enum EntityType {
    TASK
    PROJECT
    CLIENT
    DOCUMENT
    USER
}
model Client {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  ownerId        String
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User          @relation(fields: [ownerId], references: [id])
  contacts     Contact[]
  activities   CRMActivity[]

  @@index([organizationId, deletedAt])
@@index([organizationId, createdAt])
 @@unique([organizationId, name])
@@index([organizationId])
@@index([ownerId])
@@index([organizationId, status])
}

model Contact {
  id             String    @id @default(uuid())
  organizationId String
  clientId       String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  designation    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

@@index([email])
  @@index([organizationId])
  @@index([clientId])
  
}

model Lead {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  source         String?
  score          Int        @default(0) // 0-100
  status         LeadStatus @default(NEW)
  assignedTo     String?
  expectedValue  Decimal?   @db.Decimal(12,2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee      User?         @relation(fields: [assignedTo], references: [id])
  opportunities Opportunity[]
  activities    CRMActivity[]

  @@index([organizationId, score])
  @@index([organizationId])
  @@index([assignedTo])
}

model PipelineStage {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  probability    Int    @default(0)
  position Decimal @db.Decimal(18,6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([organizationId, name])
@@index([organizationId])
}

model Opportunity {
  id              String    @id @default(uuid())
  organizationId  String
  leadId          String
  stageId         String
  expectedRevenue Decimal? @db.Decimal(12,2)
  closeDate       DateTime?
probability Int @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  activities   CRMActivity[]

@@index([organizationId, stageId])
@@index([organizationId, leadId])
}

model CRMActivity {
  id             String          @id @default(uuid())
  organizationId String
  type           CRMActivityType
  description       String          @db.Text
  clientId       String?
  leadId         String?
  opportunityId  String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

@@index([organizationId, createdAt])
  @@index([organizationId])
  @@index([clientId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdById])
}

model CalendarEvent {
  id             String   @id @default(uuid())
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// FEATURE (ledger #3, 2026-08-05 — real calendar OAuth + persistence):
// the old flow fabricated tokens/emails and crammed orgId-only CalendarEvent
// shell rows instead of persisting an account. This is the real account
// store: one row per (org, user, provider), AES-256-GCM-encrypted tokens
// at rest (encryption.util), real account email from the provider's
// id_token, and provider-reported token expiry for future refresh flows.
enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

model CalendarAccount {
  id                   String           @id @default(uuid())
  organizationId       String
  userId               String
  provider             CalendarProvider
  email                String
  accessToken          String           @db.Text
  refreshToken         String?          @db.Text
  accessTokenExpiresAt DateTime
  scopes               String?
  lastSyncedAt         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([organizationId])
  @@index([userId])
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType @default(INFO)
  title          String
  message        String
  link           String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, read])
@@index([organizationId, createdAt])
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  type           ActivityType
  entityType     EntityType
  entityId       String
  metadata       Json?

  ipAddress      String?
  userAgent      String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@index([entityType, entityId])
}

// FEATURE (ledger #15 — 2026-08-05): terminal RAG ingestion outcomes.
// Values mirror RagIngestResult.status 1:1 so the processor needs no
// mapping; 'not_processed' exists ONLY for the #15 backfill of rows
// uploaded before outcome tracking shipped.
enum DocumentIngestStatus {
  ingested
  partial_budget
  skipped
  not_processed
}

model Document {
  id               String   @id @default(uuid())
  organizationId   String
  projectId        String?
  taskId           String?
  uploadedById     String

  fileName         String
  originalName     String
  mimeType         String
  fileSize         Int

  storageKey       String
  storageProvider  String @default("local")

  checksum         String?          // SHA-256 for duplicate detection

  version          Int @default(1)
  isLatest         Boolean @default(true)

  parentDocumentId String?

  // FEATURE (ledger #15 — 2026-08-05): outcome of the LAST terminal RAG
  // ingestion pass for this row (rag-ingestion.processor is the only
  // writer). null = never tracked here (fresh upload, job pending). All
  // three fields are updated together per pass; ingestReason is UI-safe
  // (never document content) and CLEARED on a successful pass.
  ingestStatus DocumentIngestStatus?
  ingestedAt   DateTime?
  ingestReason String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task           Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy     User @relation(fields: [uploadedById], references: [id])
  parentDocument Document? @relation("DocumentVersions", fields: [parentDocumentId], references: [id])

  // FEATURE (ledger #9): RAG embedding chunks — cascade on hard delete;
  // soft-delete wipes happen in DocumentService.deleteDocument.
  embeddings     DocumentEmbedding[]
  versions       Document[] @relation("DocumentVersions")

  @@index([organizationId, isLatest])
  @@index([organizationId, deletedAt])
  @@index([organizationId, projectId])
  @@index([organizationId, taskId])
  @@index([parentDocumentId])
}
model AIUsageLog {
  id               String      @id @default(uuid())
  organizationId   String
  userId           String

  provider         AIProvider
  model            String
  requestId        String?

  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)

  latencyMs        Int?
  cost             Decimal?    @default(0) @db.Decimal(12,4)

  feature          String
  success          Boolean     @default(true)
  errorMessage     String?     @db.Text

  createdAt        DateTime    @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, feature])
  @@index([organizationId, createdAt])
  @@index([requestId])
}

// FEATURE (ledger #9 — 2026-08-05): pgvector storage for the RAG ingestion
// pipeline. Every row is one ~1000-char overlapping chunk of an ingested
// document with its REAL provider embedding (OpenAI text-embedding-3-small
// by default, 1536 dims — keep the column width in lockstep with
// AI_EMBEDDING_MODEL if swapped). Two retrieval modes consume this table:
//   1. vector cosine (`embedding <=> query`) via the HNSW index, and
//   2. the HONEST lexical fallback (ledger #9): pg_trgm word_similarity /
// ILIKE over contentChunk + the pg-generated `searchText` tsvector column
//     when pgvector isn't provisioned — distances are NULL (never a
//     fabricated 0.2 → "80% Match") with retrievalMethod='text_fallback'.
// Provisioning SQL lives in prisma/migrations/20260805010000_document_embeddings
// (HNSW + pg_trgm GIN + GIN tsvector indexes, CREATE EXTENSION guarded).
// Rows hard-delete with their document (uploadNewVersion / deleteDocument
// wipe first); a security sweep can purge per-tenant via
// VectorService.deleteChunksForOrganization.
model DocumentEmbedding {
  id             String   @id @default(uuid())
  organizationId String
  documentId     String?
  taskId         String?
  projectId      String?
  contentChunk   String   @db.Text
  // FEATURE (ledger #16 — 2026-08-05): sha256 hex of contentChunk, written
  // by VectorService.storeVectorChunk for every new row. Enables zero-spend
  // reuse of byte-identical chunks (re-point / copy-insert instead of a
  // fresh provider call). Nullable: pre-#16 rows are backfilled by the
  // migration via SQL digest over contentChunk.
  chunkHash      String?
  embedding      Unsupported("vector(1536)")?
  // pg-generated tsvector over contentChunk (migration-only; Prisma reads
  // it as an Unsupported column with a db-generated default).
  searchText     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english', \"contentChunk\")"))
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  // FEATURE (ledger #16): dedupe pool lookup is org-scoped by hash.
  @@index([organizationId, chunkHash])
  // NOTE: the contentChunk GIN trigram index (gin_trgm_ops) is
  // migration-only — Prisma 5's @@index has no `ops` argument (P1012); see
  // migrations/20260805010000_document_embeddings/migration.sql.
}
// FEATURE (ledger #10 — 2026-08-05): webhook side-effect idempotency.
// Stripe retries every non-2xx (and replays from the Dashboard) within ~3
// days of the first attempt; before this table the webhook handler ran its
// side effects (org plan update, realtime broadcast, SEND_BILLING_RECEIPT
// email, ProjectUpdated audit row) on EVERY delivery — duplicate receipt
// emails and duplicate audit entries for one genuine event. The
// (provider, eventId) unique key makes the claim atomic: the first
// delivery inserts a PROCESSING row; retries see PROCESSED (skip, 200) or
// FAILED/stale-PROCESSING (guarded re-claim, attempts incremented). See
// StripeBillingService.handleWebhookEvent. Payloads are intentionally not
// stored — the Stripe Dashboard holds them; this is a claim ledger, not an
// event archive.
enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id              String             @id @default(uuid())
  provider        String
  eventId         String
  eventType       String
  status          WebhookEventStatus @default(PROCESSING)
  attempts        Int                @default(1)
  lastError       String?            @db.Text
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([provider, eventId])
  @@index([provider, status])
}
