# Local API runtime
NODE_ENV=development
PORT=4000

# PostgreSQL and Redis match the root docker-compose.yml defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamsynch-ai
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamsynch-ai
REDIS_URL=redis://localhost:6379

# Development-only secrets. Replace these before using non-local data.
JWT_ACCESS_SECRET=teamsynch_access_secret_key_32_characters_min
JWT_REFRESH_SECRET=teamsynch_refresh_secret_key_32_characters_min
ENCRYPTION_SECRET_KEY=teamsynch_encryption_secret_key_32_chars_min
STORAGE_SIGNING_SECRET=teamsynch_storage_signing_secret_32chars_min
INVITATION_SIGNING_SECRET=teamsynch_invitation_signing_secret_32chars_min
JWT_ISSUER=teamsynch-ai-api
JWT_ACCESS_AUDIENCE=teamsynch-ai-api
JWT_REFRESH_AUDIENCE=teamsynch-ai-auth
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Local browser and API origins
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# The mock provider keeps ordinary local development offline.
AI_PROVIDER=MOCK
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMS=1536
AI_RAG_MONTHLY_TOKEN_BUDGET=5000000
AI_RAG_MAX_CHARS_PER_DOC=250000

# Store uploads under apps/api/uploads for local development.
STORAGE_PROVIDER=local

# Optional integrations. Add real credentials only when testing them.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# CALENDAR_OAUTH_STATE_SECRET=

# Swagger UI is enabled by default in development. Set explicitly if needed.
# ENABLE_API_DOCS=true
